{
  "name": "2ASSE – assembleur x86-64",
  "build": { "dockerfile": "Dockerfile" },
  "runArgs": ["--cap-add=SYS_PTRACE", "--security-opt", "seccomp=unconfined"],
  "containerEnv": { "DEBUGINFOD_URLS": "" },
  "postCreateCommand": "command -v nasm >/dev/null && command -v gdb >/dev/null || bash .devcontainer/install.sh",
  "customizations": {
    "vscode": {
      "extensions": ["13xforever.language-x86-64-assembly"]
    }
  }
}
